AI_API_KEY=                  # Anthropic (console.anthropic.com) or OpenAI (platform.openai.com) — for Ask UpNorth
STRIPE_SECRET_KEY=           # dashboard.stripe.com — for business listing payments
STRIPE_PRICE_ENHANCED=       # Stripe Price ID for the Enhanced tier
STRIPE_PRICE_FEATURED=       # Stripe Price ID for the Featured tier
NEWSLETTER_API_KEY=          # Mailchimp / ConvertKit / Resend — for the "Stay Up North" newsletter
EMAIL_API_KEY=               # Resend / SendGrid — for new-listing notification emails
GOOGLE_MAPS_API_KEY=         # console.cloud.google.com — for real map embeds on town/listing pages
NEXT_PUBLIC_SITE_URL=        # Optional: your production URL (e.g. https://upnorth.org) for sitemap and social tags
